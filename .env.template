# Copy this file to .env (or just run `python main.py configure`). .env is gitignored.
# Never commit real keys: this repository is public.

# ---------------------------------------------------------------- sender identity
# Defaults already live in config/settings.py. Uncomment only to override.
# SENDER_NAME=Varun Kaveti
# SENDER_TITLE=President, Penn State Men's Club Volleyball
# SENDER_EMAIL=pennstatemcvb@gmail.com
# TEAM_INSTAGRAM=@psumensclubvolleyball
# PERSONAL_INSTAGRAM=@varunkaveti

# ---------------------------------------------------------------- drafting model
# Pick one provider: anthropic or gemini
LLM_PROVIDER=anthropic

# Anthropic (Claude). Key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Server-side fallback if the model declines a request. Turn off with false.
ANTHROPIC_REFUSAL_FALLBACK=true

# Google Gemini. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------- google sheet
# Filled in automatically by `python main.py init-sheet`. A full sheet URL also works.
SPREADSHEET_ID=
WORKSHEET_NAME=Outreach Queue
# Comma-separated Google accounts that should get edit access to the new sheet
SHARE_SHEET_WITH=

# ---------------------------------------------------------------- lead discovery (optional)
# The CSV importer works without any of these.
DISCOVERY_BACKEND=hunter
# Hunter: https://hunter.io/api-keys
HUNTER_API_KEY=
# Apollo: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=

# ---------------------------------------------------------------- guardrails
# Brands we already work with. Drafts that name any of these are rejected and rewritten.
BANNED_BRANDS=Celsius
# Lower the per-run send cap if you like. Values above 15 are ignored.
MAX_EMAILS_PER_RUN=15
